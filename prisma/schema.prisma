// Drive Connect - Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model PartnerApplication {
  id                      Int          @id @default(autoincrement())
  businessName            String       @db.VarChar(255)
  ownerName               String       @db.VarChar(255)
  email                   String       @db.VarChar(255)
  phone                   String       @db.VarChar(50)
  primaryCity             String       @db.VarChar(255)
  additionalCities        String?      @db.Text
  numberOfVehicles        Int
  vehicleTypes            String       @db.Text
  currentPlatforms        String       @db.Text
  turoProfileUrl          String?      @db.VarChar(500)
  offersAirportDelivery   Boolean      @default(false)
  offersHomeDelivery      Boolean      @default(false)
  hasCommercialInsurance  Boolean      @default(false)
  supportsSameDayBookings Boolean      @default(false)
  operates24x7            Boolean      @default(false)
  wouldUseDCSupport       Boolean      @default(false)
  status                  String       @default("pending") @db.VarChar(50)
  adminNotes              String?      @db.Text
  reviewedAt              DateTime?
  reviewedBy              String?      @db.VarChar(255)
  approvalToken           String?      @db.VarChar(255)
  approvalTokenUsed       Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  hostAccount             HostAccount?

  @@map("partner_applications")
}

model HostAccount {
  id                   Int                @id @default(autoincrement())
  applicationId        Int                @unique
  email                String             @unique @db.VarChar(255)
  passwordHash         String             @db.VarChar(255)
  businessName         String             @db.VarChar(255)
  ownerName            String             @db.VarChar(255)
  phone                String?            @db.VarChar(50)
  logoUrl              String?            @db.VarChar(500)
  description          String?            @db.Text
  serviceAreas         String?            @db.Text
  profileCompleted     Boolean            @default(false)
  onboardingStep       Int                @default(0)
  onboardingCompleted  Boolean            @default(false)
  insuranceDocUrl      String?            @db.VarChar(500)
  insuranceDocName     String?            @db.VarChar(255)
  insuranceVerified    Boolean            @default(false)
  bankAccountName      String?            @db.VarChar(255)
  bankAccountNumber    String?            @db.VarChar(255)
  bankRoutingNumber    String?            @db.VarChar(50)
  bankAccountType      String?            @db.VarChar(50)
  payoutEmail          String?            @db.VarChar(255)
  bankingInfoCompleted Boolean            @default(false)
  resetToken           String?            @db.VarChar(255)
  resetTokenExpiry     DateTime?
  isActive             Boolean            @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  application          PartnerApplication @relation(fields: [applicationId], references: [id])
  vehicles             Vehicle[]
  sessions             HostSession[]
  bookings             Booking[]
  messages             Message[]
  claims               Claim[]
  operatorBids         OperatorBid[]
  bidSettlements       BidSettlement[]
  depositRecords       DepositRecord[]  @relation("OperatorDeposits")
  depositClaims        DepositClaim[]   @relation("OperatorClaims")

  @@map("host_accounts")
}

model HostSession {
  id           Int         @id @default(autoincrement())
  hostId       Int
  sessionToken String      @unique @db.VarChar(255)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  host         HostAccount @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@map("host_sessions")
}

model Vehicle {
  id                  Int         @id @default(autoincrement())
  hostId              Int
  year                Int
  make                String      @db.VarChar(100)
  model               String      @db.VarChar(100)
  trim                String?     @db.VarChar(100)
  color               String?     @db.VarChar(50)
  licensePlate        String?     @db.VarChar(50)
  vin                 String?     @db.VarChar(50)
  mileage             Int?
  seats               Int         @default(5)
  fuelType            String      @default("Gasoline") @db.VarChar(50)
  transmission        String      @default("Automatic") @db.VarChar(50)
  dailyRate           Decimal     @db.Decimal(10, 2)
  weeklyRate          Decimal?    @db.Decimal(10, 2)
  monthlyRate         Decimal?    @db.Decimal(10, 2)
  securityDeposit     Decimal?    @db.Decimal(10, 2)
  mileageIncluded     Int?
  hasGPS              Boolean     @default(false)
  hasBluetooth        Boolean     @default(false)
  hasCarPlay          Boolean     @default(false)
  hasChargingCable    Boolean     @default(false)
  hasChildSeat        Boolean     @default(false)
  offersAirportPickup Boolean     @default(false)
  offersHomeDelivery  Boolean     @default(false)
  deliveryFee         Decimal?    @db.Decimal(10, 2)
  description         String?     @db.Text
  vehicleRules        String?     @db.Text
  pickupInstructions  String?     @db.Text
  status              String      @default("active") @db.VarChar(50)
  photos              String?     @db.Text
  category            String      @default("Sedan") @db.VarChar(50)
  city                String?     @db.VarChar(255)
  zipCode             String?     @db.VarChar(20)
  rating              Decimal     @default(0.0) @db.Decimal(3, 1)
  trips               Int         @default(0)
  unlimitedMiles      Boolean     @default(false)
  // Phase 6D: AI-generated description flag
  aiDescriptionGenerated Boolean  @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  host                HostAccount @relation(fields: [hostId], references: [id])
  bookings            Booking[]
  claims              Claim[]
  favorites           Favorite[]
  reviews             Review[]

  @@map("vehicles")
}

model Booking {
  id                  Int      @id @default(autoincrement())
  bookingReference    String   @unique @db.VarChar(50)
  vehicleId           Int
  hostId              Int
  renterFirstName     String   @db.VarChar(100)
  renterLastName      String   @db.VarChar(100)
  renterEmail         String   @db.VarChar(255)
  renterPhone         String   @db.VarChar(50)
  renterLicenseNumber String   @db.VarChar(100)
  renterLicenseState  String   @db.VarChar(50)
  startDate           DateTime
  endDate             DateTime
  pickupTime          String   @db.VarChar(20)
  returnTime          String   @db.VarChar(20)
  deliveryOption      String   @db.VarChar(50)
  deliveryAddress     String?  @db.VarChar(255)
  protectionPlan      String   @db.VarChar(50)
  basePrice           Decimal  @db.Decimal(10, 2)
  protectionPrice     Decimal  @db.Decimal(10, 2)
  deliveryPrice       Decimal  @db.Decimal(10, 2)
  taxes               Decimal  @db.Decimal(10, 2)
  totalPrice          Decimal  @db.Decimal(10, 2)
  status              String   @default("pending") @db.VarChar(50) // pending, confirmed, active, completed, cancelled
  paymentStatus       String   @default("pending") @db.VarChar(50) // pending, paid, refunded, failed
  // Phase 6A: Stripe fields
  stripePaymentIntentId String? @db.VarChar(255)
  stripeChargeId        String? @db.VarChar(255)
  // Phase 6C: Insurance fields
  insuranceTier         String? @db.VarChar(50) // basic, standard, premium
  insuranceAmount       Decimal? @db.Decimal(10, 2)
  // Phase 6E: Dynamic pricing fields
  pricingMultiplier     Decimal? @db.Decimal(5, 4)
  earlyBirdDiscount     Decimal? @db.Decimal(10, 2)
  durationDiscount      Decimal? @db.Decimal(10, 2)
  priceBreakdown        String?  @db.Text // JSON
  hostPayoutAmount    Decimal? @db.Decimal(10, 2)
  platformFeeAmount   Decimal? @db.Decimal(10, 2)
  payoutStatus        String   @default("pending") @db.VarChar(50) // pending, processing, paid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vehicle  Vehicle     @relation(fields: [vehicleId], references: [id])
  host     HostAccount @relation(fields: [hostId], references: [id])
  messages Message[]
  claims   Claim[]

  depositRecords DepositRecord[]
  depositClaims  DepositClaim[]
  review Review?
  @@map("bookings")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(255)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model Message {
  id          Int      @id @default(autoincrement())
  bookingId   Int?
  hostId      Int
  renterEmail String   @db.VarChar(255)
  senderType  String   @db.VarChar(50) // 'host', 'renter', 'system'
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  booking Booking?    @relation(fields: [bookingId], references: [id])
  host    HostAccount @relation(fields: [hostId], references: [id])

  @@map("messages")
}

model Claim {
  id             Int      @id @default(autoincrement())
  claimReference String   @unique @db.VarChar(50)
  bookingId      Int
  hostId         Int
  vehicleId      Int
  status         String   @default("open") @db.VarChar(50)
  description    String   @db.Text
  photos         String?  @db.Text
  estimatedCost  Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking Booking     @relation(fields: [bookingId], references: [id])
  host    HostAccount @relation(fields: [hostId], references: [id])
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id])

  @@map("claims")
}


model RenterAccount {
  id                   Int             @id @default(autoincrement())
  email                String          @unique @db.VarChar(255)
  passwordHash         String          @db.VarChar(255)
  firstName            String          @db.VarChar(100)
  lastName             String          @db.VarChar(100)
  phone                String?         @db.VarChar(50)
  profileImageUrl      String?         @db.VarChar(500)
  licenseNumber        String?         @db.VarChar(100)
  licenseState         String?         @db.VarChar(50)
  licenseVerified      Boolean         @default(false)
  // Phase 6B: Identity verification fields
  licenseImageFront    String?         @db.VarChar(500)
  licenseImageBack     String?         @db.VarChar(500)
  verificationStatus   String          @default("unverified") @db.VarChar(50) // unverified, pending, verified, rejected
  verificationNotes    String?         @db.Text
  verificationReviewedAt DateTime?
  resetToken           String?         @db.VarChar(255)
  resetTokenExpiry     DateTime?
  isActive             Boolean         @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  // Phase 7F: Trusted Renter fields
  trustedStatus        String          @default("unverified") @db.VarChar(50) // unverified, pending, trusted, suspended, banned
  trustedSince         DateTime?
  trustScore           Int             @default(0)
  sessions             RenterSession[]
  favorites            Favorite[]
  reviews              Review[]
  activityLogs         RenterActivityLog[]
  fraudSignals         FraudSignal[]

  @@map("renter_accounts")
}

model RenterSession {
  id           Int           @id @default(autoincrement())
  renterId     Int
  sessionToken String        @unique @db.VarChar(255)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  renter       RenterAccount @relation(fields: [renterId], references: [id], onDelete: Cascade)
  @@map("renter_sessions")
}

model Favorite {
  id        Int           @id @default(autoincrement())
  renterId  Int
  vehicleId Int
  createdAt DateTime      @default(now())
  renter    RenterAccount @relation(fields: [renterId], references: [id], onDelete: Cascade)
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@unique([renterId, vehicleId])
  @@map("favorites")
}

model Review {
  id        Int           @id @default(autoincrement())
  renterId  Int
  bookingId Int           @unique
  vehicleId Int
  rating    Int
  text      String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  renter    RenterAccount @relation(fields: [renterId], references: [id], onDelete: Cascade)
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@map("reviews")
}

// Phase 7F: Blacklisted Renters
model BlacklistedRenter {
  id            Int       @id @default(autoincrement())
  renterId      Int?
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  licenseNumber String?   @db.VarChar(100)
  reason        String    @db.VarChar(50) // fraud, stolen_identity, repeated_claims, chargebacks, banned_by_operator
  addedBy       Int?
  addedAt       DateTime  @default(now())
  expiresAt     DateTime?
  notes         String?   @db.Text
  isActive      Boolean   @default(true)

  @@map("blacklisted_renters")
}

// Phase 7F: IP & Device Activity Logging
model RenterActivityLog {
  id              Int           @id @default(autoincrement())
  renterId        Int?
  ipAddress       String        @db.VarChar(45)
  userAgent       String?       @db.Text
  fingerprintHash String?       @db.VarChar(255)
  action          String        @db.VarChar(50) // login, booking_attempt, payment_attempt, registration, verification_attempt
  timestamp       DateTime      @default(now())
  flagged         Boolean       @default(false)
  flagReason      String?       @db.VarChar(500)
  renter          RenterAccount? @relation(fields: [renterId], references: [id], onDelete: SetNull)

  @@map("renter_activity_logs")
}

// Phase 7F: Fraud Signals
model FraudSignal {
  id              Int           @id @default(autoincrement())
  renterId        Int
  signalType      String        @db.VarChar(50) // multiple_failed_payments, rapid_bookings, blacklist_match, ip_anomaly, identity_mismatch, suspicious_pattern
  severity        String        @db.VarChar(20) // low, medium, high, critical
  details         Json?
  autoActionTaken String        @default("none") @db.VarChar(20) // none, flagged, blocked, suspended
  reviewedBy      Int?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  renter          RenterAccount @relation(fields: [renterId], references: [id], onDelete: Cascade)

  @@map("fraud_signals")
}

model SippCode {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(10)
  name             String   @db.VarChar(100)
  description      String?  @db.VarChar(255)
  category         String   @db.VarChar(50)
  baseRatePerDay   Decimal  @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  opportunities    BookingOpportunity[]
  @@map("sipp_codes")
}

model MarketPricing {
  id               Int      @id @default(autoincrement())
  marketName       String   @unique @db.VarChar(100)
  marketCode       String   @unique @db.VarChar(20)
  state            String?  @db.VarChar(50)
  country          String   @default("US") @db.VarChar(50)
  priceMultiplier  Decimal  @default(1.0000) @db.Decimal(5, 4)
  acquisitionCost  Decimal  @default(15.00) @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  opportunities    BookingOpportunity[]
  @@map("market_pricing")
}

model PricingRule {
  id             Int      @id @default(autoincrement())
  ruleName       String   @db.VarChar(100)
  ruleType       String   @db.VarChar(50)
  conditionKey   String   @db.VarChar(100)
  conditionValue String   @db.VarChar(255)
  multiplier     Decimal  @default(1.0000) @db.Decimal(5, 4)
  description    String?  @db.VarChar(255)
  isActive       Boolean  @default(true)
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@map("pricing_rules")
}

model BookingOpportunity {
  id                   Int      @id @default(autoincrement())
  opportunityReference String   @unique @db.VarChar(50)
  sippCodeId           Int
  marketId             Int
  pickupLocation       String   @db.VarChar(255)
  dropoffLocation      String   @db.VarChar(255)
  pickupDate           DateTime @db.Date
  dropoffDate          DateTime @db.Date
  rentalDays           Int
  renterName           String?  @db.VarChar(255)
  renterEmail          String?  @db.VarChar(255)
  retailPricePerDay    Decimal  @db.Decimal(10, 2)
  retailPriceTotal     Decimal  @db.Decimal(10, 2)
  minimumBidPerDay     Decimal  @db.Decimal(10, 2)
  minimumBidTotal      Decimal  @db.Decimal(10, 2)
  biddingWindowHours   Int      @default(4)
  biddingClosesAt      DateTime
  status               String   @default("open") @db.VarChar(50)
  autoAcceptLowest     Boolean  @default(true)
  priceBreakdown       String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  sippCode             SippCode       @relation(fields: [sippCodeId], references: [id])
  market               MarketPricing  @relation(fields: [marketId], references: [id])
  bids                 OperatorBid[]
  settlement           BidSettlement?
  @@map("booking_opportunities")
}

model OperatorBid {
  id                      Int      @id @default(autoincrement())
  opportunityId           Int
  operatorId              Int
  bidPerDay               Decimal  @db.Decimal(10, 2)
  bidTotal                Decimal  @db.Decimal(10, 2)
  estimatedMarginPerDay   Decimal  @db.Decimal(10, 2)
  estimatedMarginTotal    Decimal  @db.Decimal(10, 2)
  status                  String   @default("pending") @db.VarChar(50)
  notes                   String?  @db.Text
  submittedAt             DateTime @default(now())
  withdrawnAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  opportunity             BookingOpportunity @relation(fields: [opportunityId], references: [id])
  operator                HostAccount        @relation(fields: [operatorId], references: [id])
  settlement              BidSettlement?
  @@unique([opportunityId, operatorId])
  @@map("operator_bids")
}

model BidSettlement {
  id                    Int      @id @default(autoincrement())
  settlementReference   String   @unique @db.VarChar(50)
  opportunityId         Int      @unique
  winningBidId          Int      @unique
  operatorId            Int
  retailPriceTotal      Decimal  @db.Decimal(10, 2)
  winningBidTotal       Decimal  @db.Decimal(10, 2)
  operatorMarginTotal   Decimal  @db.Decimal(10, 2)
  platformRevenue       Decimal  @db.Decimal(10, 2)
  paymentProcessingFee  Decimal  @db.Decimal(10, 2)
  acquisitionCost       Decimal  @db.Decimal(10, 2)
  stripeChargeId        String?  @db.VarChar(255)
  stripePaymentIntentId String?  @db.VarChar(255)
  status                String   @default("pending") @db.VarChar(50)
  operatorNotifiedAt    DateTime?
  chargedAt             DateTime?
  completedAt           DateTime?
  adminNotes            String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  opportunity           BookingOpportunity @relation(fields: [opportunityId], references: [id])
  winningBid            OperatorBid        @relation(fields: [winningBidId], references: [id])
  operator              HostAccount        @relation(fields: [operatorId], references: [id])
  @@map("bid_settlements")
}

model DepositTier {
  id            Int      @id @default(autoincrement())
  vehicleClass  String   @unique @db.VarChar(50)
  minAmount     Decimal  @db.Decimal(10, 2)
  maxAmount     Decimal  @db.Decimal(10, 2)
  defaultAmount Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@map("deposit_tiers")
}

model DepositRecord {
  id               Int       @id @default(autoincrement())
  bookingId        Int       @unique
  operatorId       Int
  renterId         Int?
  amountRequired   Decimal   @db.Decimal(10, 2)
  amountCollected  Decimal?  @db.Decimal(10, 2)
  collectionMethod String?   @db.VarChar(50)
  status           String    @default("pending") @db.VarChar(50)
  collectedAt      DateTime?
  returnedAt       DateTime?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  booking          Booking      @relation(fields: [bookingId], references: [id])
  operator         HostAccount  @relation("OperatorDeposits", fields: [operatorId], references: [id])
  @@map("deposit_records")
}

model DepositClaim {
  id               Int       @id @default(autoincrement())
  claimReference   String    @unique @db.VarChar(50)
  bookingId        Int
  operatorId       Int
  claimType        String    @db.VarChar(50)
  amount           Decimal   @db.Decimal(10, 2)
  description      String    @db.Text
  evidenceUrls     String?   @db.Text
  status           String    @default("filed") @db.VarChar(50)
  resolutionNotes  String?   @db.Text
  filedAt          DateTime  @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  booking          Booking      @relation(fields: [bookingId], references: [id])
  operator         HostAccount  @relation("OperatorClaims", fields: [operatorId], references: [id])
  messages         ClaimMessage[]
  @@map("deposit_claims")
}

model ClaimMessage {
  id            Int      @id @default(autoincrement())
  claimId       Int
  senderId      Int
  senderRole    String   @db.VarChar(50)
  message       String   @db.Text
  attachmentUrl String?  @db.VarChar(500)
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  claim         DepositClaim @relation(fields: [claimId], references: [id])
  @@map("claim_messages")
}
